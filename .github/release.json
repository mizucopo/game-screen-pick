{
  "version": {
    "scheme": "semver",
    "sources": [
      {
        "path": "Cargo.toml",
        "format": "toml",
        "key": ["package", "version"]
      }
    ],
    "locks": [
      { "path": "Cargo.lock", "format": "toml-lock", "package": "game-screen-pick", "optional": true }
    ]
  },
  "publication": {
    "release_tag": "{version}",
    "github_release": true,

    "release_paths": ["Cargo.toml", "Cargo.lock", ".copier-answers.yml"],
    "latest_image": null,
    "images": []
  }
}
